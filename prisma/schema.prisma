generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Configuracao {
  id         String   @id @default(uuid())
  dataInicio DateTime
  dataFim    DateTime
}
model Rsvp {
  id         String   @id @default(uuid())
  nome       String
  email      String   @unique
  telefone   String?
  confirmado Boolean  @default(true)
  criadoEm   DateTime @default(now())

  @@map("rsvps")
}